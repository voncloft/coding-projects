(version 1)
(rule "PC USB pair length"
 (condition "A.NetName == 'PC_DP' || A.NetName == 'PC_DM'")
 (constraint skew (max 1.25mm)))
(rule "CHARGE USB pair length"
 (condition "A.NetName == 'CHARGE_DP' || A.NetName == 'CHARGE_DM'")
 (constraint skew (max 1.25mm)))
(rule "UP USB pair length"
 (condition "A.NetName == 'UP_DP' || A.NetName == 'UP_DM'")
 (constraint skew (max 1.25mm)))
(rule "DN1 USB pair length"
 (condition "A.NetName == 'DN1_DP' || A.NetName == 'DN1_DM'")
 (constraint skew (max 1.25mm)))
(rule "DN2 USB pair length"
 (condition "A.NetName == 'DN2_DP' || A.NetName == 'DN2_DM'")
 (constraint skew (max .15mm)))
(rule "DN3 USB pair length"
 (condition "A.NetName == 'DN3_DP' || A.NetName == 'DN3_DM'")
 (constraint skew (max 1.25mm)))
(rule "DN4 USB pair length"
 (condition "A.NetName == 'DN4_DP' || A.NetName == 'DN4_DM'")
 (constraint skew (max 1.25mm)))
(rule "DN5 USB pair length"
 (condition "A.NetName == 'DN5_DP' || A.NetName == 'DN5_DM'")
 (constraint skew (max 1.25mm)))
